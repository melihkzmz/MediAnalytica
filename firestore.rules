rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is a doctor (has doctor document)
    function isDoctor() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
    }
    
    // Users Collection
    match /users/{userId} {
      // Users can read/update their own user document
      // Doctors can read user documents (needed for "my patients" section)
      allow read: if isOwner(userId) || isDoctor();
      allow write: if isOwner(userId);
    }
    
    // Doctors Collection
    match /doctors/{doctorId} {
      // Owner full access; any signed-in user may read profiles (directory / chat / discovery; no approval gate)
      allow read: if isAuthenticated();
      allow write: if isOwner(doctorId);
    }

    // Chat: patient→doctor or doctor→doctor (colleague); recipient doctor approves or rejects
    match /chatRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toDoctorUserId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toDoctorUserId is string &&
        request.resource.data.fromUserId != request.resource.data.toDoctorUserId &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/doctors/$(request.resource.data.toDoctorUserId)) &&
        (!('introMessage' in request.resource.data) ||
          (request.resource.data.introMessage is string && request.resource.data.introMessage.size() <= 500)) &&
        (!('requestKind' in request.resource.data) ||
          request.resource.data.requestKind in ['patient_to_doctor', 'doctor_to_doctor']) &&
        (!('requestKind' in request.resource.data) ||
          request.resource.data.requestKind != 'doctor_to_doctor' ||
          exists(/databases/$(database)/documents/doctors/$(request.auth.uid)));
      allow update: if isAuthenticated() &&
        isDoctor() &&
        resource.data.toDoctorUserId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.fromUserId == resource.data.fromUserId &&
        request.resource.data.toDoctorUserId == resource.data.toDoctorUserId &&
        request.resource.data.status in ['approved', 'rejected'] &&
        (request.resource.data.status == 'rejected' ||
          (request.resource.data.status == 'approved' &&
            request.resource.data.conversationId is string));
    }

    match /conversations/{conversationId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;
      // Recipient doctor creates after approving a chat request; patientId = requester, doctorId = approver (doctor–doctor uses same shape)
      allow create: if isAuthenticated() &&
        isDoctor() &&
        request.resource.data.doctorId == request.auth.uid &&
        request.resource.data.patientId is string &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds[0] == request.resource.data.patientId &&
        request.resource.data.participantIds[1] == request.resource.data.doctorId;
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      allow create: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // Appointments Collection
    match /appointments/{appointmentId} {
      // Read rules: Patients can read their own appointments, doctors can read all appointments
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isDoctor()
      );
      
      // Create rules: Patients create bookings (pending). Doctors invite peers (pending_peer, doctor_peer).
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        (!('appointmentKind' in request.resource.data) ||
          request.resource.data.appointmentKind == null)
      ) || (
        isDoctor() &&
        request.resource.data.appointmentKind == 'doctor_peer' &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending_peer' &&
        request.resource.data.doctorType == 'peer' &&
        request.resource.data.peerDoctorUserId is string &&
        request.resource.data.peerDoctorUserId != request.auth.uid &&
        exists(/databases/$(database)/documents/doctors/$(request.resource.data.peerDoctorUserId)) &&
        (!('reason' in request.resource.data) ||
          (request.resource.data.reason is string && request.resource.data.reason.size() <= 2000)) &&
        (!('userEmail' in request.resource.data) ||
          request.resource.data.userEmail is string)
      );
      
      // Update rules: 
      // 1. Patients can update jitsiRoom field on their own pending appointments (right after creation)
      // 2. Doctors can approve/reject pending appointments (sets doctorId, status, approvedAt)
      // 3. Doctors can complete approved appointments assigned to them
      // 4. Patients can cancel their own approved appointments with reason
      // 5. Assigned doctors can cancel approved appointments with reason
      allow update: if isAuthenticated() && (
        // Case 1: Patients can update jitsiRoom on their own pending appointments
        (resource.data.status == 'pending' && 
         resource.data.userId == request.auth.uid &&
         request.resource.data.status == 'pending' &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.userEmail == resource.data.userEmail &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType) ||
        // Case 1b: Organizer updates jitsiRoom on pending doctor–doctor peer invite
        (resource.data.appointmentKind == 'doctor_peer' &&
         resource.data.status == 'pending_peer' &&
         resource.data.userId == request.auth.uid &&
         request.resource.data.status == 'pending_peer' &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.peerDoctorUserId == resource.data.peerDoctorUserId &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType &&
         request.resource.data.appointmentKind == resource.data.appointmentKind &&
         (!('userEmail' in resource.data) || request.resource.data.userEmail == resource.data.userEmail)) ||
        // Case 2: Doctors can approve/reject pending appointments (sets doctorId, status, approvedAt)
        (isDoctor() && 
         resource.data.status == 'pending' && 
         request.resource.data.status in ['approved', 'rejected'] &&
         request.resource.data.doctorId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.userEmail == resource.data.userEmail &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType) ||
        // Case 2b: Invitee doctor accepts peer meeting
        (isDoctor() &&
         resource.data.appointmentKind == 'doctor_peer' &&
         resource.data.status == 'pending_peer' &&
         resource.data.peerDoctorUserId == request.auth.uid &&
         request.resource.data.status == 'approved' &&
         request.resource.data.doctorId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.peerDoctorUserId == resource.data.peerDoctorUserId &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType &&
         request.resource.data.appointmentKind == resource.data.appointmentKind &&
         (!('userEmail' in resource.data) || request.resource.data.userEmail == resource.data.userEmail)) ||
        // Case 2c: Invitee rejects peer meeting
        (isDoctor() &&
         resource.data.appointmentKind == 'doctor_peer' &&
         resource.data.status == 'pending_peer' &&
         resource.data.peerDoctorUserId == request.auth.uid &&
         request.resource.data.status == 'rejected' &&
         request.resource.data.doctorId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.peerDoctorUserId == resource.data.peerDoctorUserId &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType &&
         request.resource.data.appointmentKind == resource.data.appointmentKind &&
         (!('userEmail' in resource.data) || request.resource.data.userEmail == resource.data.userEmail)) ||
        // Case 2d: Organizer cancels pending peer invite
        (resource.data.appointmentKind == 'doctor_peer' &&
         resource.data.status == 'pending_peer' &&
         resource.data.userId == request.auth.uid &&
         request.resource.data.status == 'cancelled_peer' &&
         request.resource.data.cancelledByUid == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.peerDoctorUserId == resource.data.peerDoctorUserId &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType &&
         request.resource.data.appointmentKind == resource.data.appointmentKind &&
         (!('userEmail' in resource.data) || request.resource.data.userEmail == resource.data.userEmail) &&
         (!('cancelReason' in request.resource.data) ||
           (request.resource.data.cancelReason is string &&
            request.resource.data.cancelReason.size() <= 1000))) ||
        // Case 3: Doctors complete approved appointments (assigned doctor, or peer organizer)
        (isDoctor() && 
         resource.data.status == 'approved' && 
         request.resource.data.status == 'completed' &&
         (resource.data.doctorId == request.auth.uid ||
           (resource.data.appointmentKind == 'doctor_peer' && resource.data.userId == request.auth.uid)) &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.userEmail == resource.data.userEmail &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType &&
         request.resource.data.doctorId == resource.data.doctorId &&
         (!('peerDoctorUserId' in resource.data) || request.resource.data.peerDoctorUserId == resource.data.peerDoctorUserId) &&
         (!('appointmentKind' in resource.data) || request.resource.data.appointmentKind == resource.data.appointmentKind)) ||
        // Case 3b: Patient (booking owner) completes approved non–peer appointment (e.g. after video call)
        (resource.data.status == 'approved' &&
         request.resource.data.status == 'completed' &&
         resource.data.userId == request.auth.uid &&
         (!('appointmentKind' in resource.data) || resource.data.appointmentKind != 'doctor_peer') &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.userEmail == resource.data.userEmail &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType &&
         request.resource.data.doctorId == resource.data.doctorId &&
         (!('peerDoctorUserId' in resource.data) || request.resource.data.peerDoctorUserId == resource.data.peerDoctorUserId) &&
         (!('appointmentKind' in resource.data) || request.resource.data.appointmentKind == resource.data.appointmentKind)) ||
        // Case 4: Patient cancels own approved appointment with a reason
        (resource.data.status == 'approved' &&
         resource.data.userId == request.auth.uid &&
         request.resource.data.status == 'cancelled_by_patient' &&
         request.resource.data.cancelledByRole == 'patient' &&
         request.resource.data.cancelledByUid == request.auth.uid &&
         request.resource.data.cancelReason is string &&
         request.resource.data.cancelReason.size() > 0 &&
         request.resource.data.cancelReason.size() <= 1000 &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.userEmail == resource.data.userEmail &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType &&
         request.resource.data.doctorId == resource.data.doctorId &&
         (!('peerDoctorUserId' in resource.data) || request.resource.data.peerDoctorUserId == resource.data.peerDoctorUserId) &&
         (!('appointmentKind' in resource.data) || request.resource.data.appointmentKind == resource.data.appointmentKind)) ||
        // Case 5: Assigned doctor cancels approved appointment with a reason
        (isDoctor() &&
         resource.data.status == 'approved' &&
         resource.data.doctorId == request.auth.uid &&
         request.resource.data.status == 'cancelled_by_doctor' &&
         request.resource.data.cancelledByRole == 'doctor' &&
         request.resource.data.cancelledByUid == request.auth.uid &&
         request.resource.data.cancelReason is string &&
         request.resource.data.cancelReason.size() > 0 &&
         request.resource.data.cancelReason.size() <= 1000 &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.userEmail == resource.data.userEmail &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         request.resource.data.reason == resource.data.reason &&
         request.resource.data.doctorType == resource.data.doctorType &&
         request.resource.data.doctorId == resource.data.doctorId &&
         (!('peerDoctorUserId' in resource.data) || request.resource.data.peerDoctorUserId == resource.data.peerDoctorUserId) &&
         (!('appointmentKind' in resource.data) || request.resource.data.appointmentKind == resource.data.appointmentKind))
      );
    }
    
    // Analyses Collection
    match /analyses/{analysisId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // Favorites Collection
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // Shared Analyses Collection
    match /shared_analyses/{shareId} {
      allow read: if true; // Public read (for shared links)
      allow create: if isAuthenticated();
    }
  }
}